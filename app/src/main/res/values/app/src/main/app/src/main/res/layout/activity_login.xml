<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GupShup Party"
        android:textColor="@color/royal_gold"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="ROYAL VIP VOICE &amp; PARTY"
        android:textColor="@color/electric_teal"
        android:textSize="13sp"
        android:letterSpacing="0.15" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnVipLogin"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_gold_button"
        android:text="Continue as VIP"
        android:textAllCaps="false"
        android:textColor="@color/navy_bg"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
