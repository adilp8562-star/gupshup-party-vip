<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090C18"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvRoomTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GupShup VIP Voice Room"
        android:textColor="#FFD54F"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRoomSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Clear Voice Ready • 9 Seats Open"
        android:textColor="#38BDF8"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvRoomStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="200,000 Base Coins • 30s Gold Coin Greedy"
        android:textColor="#FACC15"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnToggleMic"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:text="Mic: ON (Clear Voice)" />

    <Button
        android:id="@+id/btnBackLobby"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="Exit Room" />

</LinearLayout>
